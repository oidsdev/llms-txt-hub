{
  "name": "generator",
  "version": "1.0.0",
  "private": true,
  "description": "Draft llms.txt files from a sitemap, and generate unofficial files with the Firecrawl API",
  "type": "module",
  "scripts": {
    "sitemap": "tsx src/sitemap-cli.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test src/sitemap/draft.test.ts src/sitemap/robots.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.29.3",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "firecrawl": "^1.29.3",
    "inquirer": "^12.11.1",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
